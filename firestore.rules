rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      // Allow reading room states for active matchmaking and multiplayer sync
      allow read: if true;

      // Ensure room creation includes valid code and host identity
      allow create: if request.resource.data.code is string
                   && request.resource.data.hostId is string
                   && request.resource.data.status in ['waiting', 'playing', 'ended']
                   && request.resource.data.maxPlayers >= 2
                   && request.resource.data.maxPlayers <= 4
                   && (!('region' in request.resource.data) || request.resource.data.region in ['usa', 'canada', 'global']);

      // Allow room state updates (player joins, moves, readiness, card plays)
      allow update: if resource.data.code == request.resource.data.code
                   && request.resource.data.maxPlayers >= 2
                   && request.resource.data.maxPlayers <= 4;

      // Allow room deletion when host leaves or room resets
      allow delete: if true;
    }
  }
}
